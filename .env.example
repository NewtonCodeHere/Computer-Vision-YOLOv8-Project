# Backend Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database (PostgreSQL for Docker, SQLite fallback for local development)
DATABASE_URL=sqlite:///./detection.db
# For Docker Postgres:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/detectiondb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=detectiondb

# Detection Settings
CONFIDENCE_THRESHOLD=0.50
IOU_THRESHOLD=0.45
MODEL_PATH=models/bengal_gram_yolov8.pt

# Hardware Integration (Arduino / ESP32)
HARDWARE_ENABLED=False
HARDWARE_PORT=COM3
HARDWARE_BAUDRATE=115200
MOCK_HARDWARE=True

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live
